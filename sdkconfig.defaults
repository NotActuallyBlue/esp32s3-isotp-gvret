CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y

# Standard C Library configuration
CONFIG_LIBC_NEWLIB=y
CONFIG_NEWLIB_PTHREAD_TLS=n
CONFIG_NEWLIB_ENABLE_TEDIOUS_TEST_CODE=n

# Hardware USB-Serial/JTAG console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Custom partition table with a "log" partition (see flashlog.c)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Keep the TWAI ISR running while the flash log writes
CONFIG_TWAI_ISR_IN_IRAM_LEGACY=y

# Millisecond log timestamps (RTOS ticks are only 10 ms here)
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# 1 ms RTOS tick so short waits and delays are not rounded to 10 ms
CONFIG_FREERTOS_HZ=1000

# 16 MB flash, two OTA slots with rollback, core dump to flash (see partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
